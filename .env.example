# Database. SQLite works out of the box; for Postgres/Supabase see README.
DATABASE_URL="file:./dev.db"

# Public URL of this site (used for canonical URLs, sitemap and SEO previews)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Where uploaded media is stored on disk (outside /public; served through an access-checked route)
UPLOAD_DIR="./storage/uploads"
# Max upload size in megabytes
MAX_UPLOAD_MB="20"

# Secret used to salt visitor/IP hashes for analytics. Generate with: openssl rand -hex 32
ANALYTICS_SALT="change-me"

# Secret for the scheduled-publishing cron endpoint (/api/cron/publish). Generate with: openssl rand -hex 32
CRON_SECRET="change-me"

# Initial Super Admin created by `npm run db:seed` (only if no users exist)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="Site Admin"
